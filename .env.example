# Tony Klinger platform — every environment variable, explained.
# Copy to .env.local and fill in. Never commit real values.
# Same sections and order as .env.local and .env.remote.local.
# Architecture: note 02 §30, note 09 §49. Deployment: docs/deployment.md.

# ---------- Core ----------
# Canonical site address, no trailing slash. Emails and redirects are built
# from it, never from the request (http://localhost:3000 locally).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-side only, and only where genuinely required (note 08 §61).
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret every /api/cron/[job] call must send (note 09 §44). 16+
# characters. On the test deploy the Apps Script scheduler holds the same value
# (scripts/apps-script/scheduled-jobs.gs).
CRON_SECRET=

# ---------- Stripe ----------
# Test keys (pk_test_/sk_test_) everywhere but production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From the webhook endpoint (or `stripe listen` locally), not the API keys page.
STRIPE_WEBHOOK_SECRET=
# Customer Portal settings, created by scripts/stripe-portal-setup.mjs (one per
# Stripe sandbox/mode). Unset = Stripe's default portal.
STRIPE_PORTAL_CONFIGURATION_ID=

# ---------- Google sign-in (note 05 §7.1) ----------
# Read by supabase/config.toml for the LOCAL stack. A hosted project takes the
# same values in the Supabase dashboard (Authentication -> Providers -> Google);
# the site itself never reads them.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------- Contact form ----------
# Cloudflare Turnstile. The site key is public; only the secret verifies. With
# no secret, verification FAILS CLOSED in production (every message refused)
# and passes in development. The widget's hostnames must include each domain
# it runs on, localhost too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Where contact enquiries and retreat applications are announced. The form never
# emails the address a visitor types — that would make it an open relay.
CONTACT_NOTIFICATION_EMAIL=

# ---------- Email (note 09 §41–42) ----------
# mailpit | brevo | off. Unset = mailpit in development, OFF in production, so
# an unconfigured environment can never email a real person. On Vercel it must
# be `brevo` for receipts, tickets and reminders to be sent. Everything else in
# this block only matters when it is `brevo`.
#
# The Brevo account also holds the legacy Tony Klinger Online Coaching assets;
# they must not be altered or reused (note 09 §42.2). This platform's own are all
# named "TK.com — …". The email module only ever calls the transactional send
# endpoint; the one thing that writes templates is `pnpm brevo:templates`, and it
# touches only "TK.com — " names.
EMAIL_TRANSPORT=mailpit
BREVO_API_KEY=
# Must be an address VERIFIED as a sender in Brevo, or every send is rejected.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Contact lists — sending audiences only; the consent record itself lives in
# public.marketing_consents. Syncing is gated on EMAIL_TRANSPORT=brevo.
BREVO_LIST_NEWSLETTER=
BREVO_LIST_CUSTOMERS=
BREVO_LIST_MEMBERS=
# Brevo template ids, one per email (note 09 §42.3). Each template is the site's
# layout filled with the site's own wording (subject, title, body, site_url),
# so restyle it in Brevo but change the words in src/lib/email/templates.ts.
# Unset = the site sends its own HTML instead, which is also fine. Created and
# updated by `pnpm brevo:templates`, which prints the ids (also listed in
# docs/deployment.md).
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_ORDER_RECEIPT=
BREVO_TEMPLATE_MEMBERSHIP_ACTIVATED=
BREVO_TEMPLATE_GUEST_CLAIM=
BREVO_TEMPLATE_BOOKING_CONFIRMED=
BREVO_TEMPLATE_BOOKING_CANCELLED=
BREVO_TEMPLATE_CONTACT_ENQUIRY=
BREVO_TEMPLATE_EVENT_TICKET=
BREVO_TEMPLATE_EVENT_PLACE_AVAILABLE=
BREVO_TEMPLATE_EVENT_REMINDER=
BREVO_TEMPLATE_EVENT_STARTING=
BREVO_TEMPLATE_SESSION_REMINDER=
BREVO_TEMPLATE_SESSION_STARTING=
BREVO_TEMPLATE_PASS_ENDING=
BREVO_TEMPLATE_PRIVATE_COACHING_REBOOK=
BREVO_TEMPLATE_SECURITY_KEY_REMOVED=
BREVO_TEMPLATE_ACCOUNT_EXISTS=
BREVO_TEMPLATE_RETREAT_APPLICATION_RECEIVED=
BREVO_TEMPLATE_RETREAT_APPLICATION_SENT=
BREVO_TEMPLATE_RETREAT_APPLICATION_APPROVED=
BREVO_TEMPLATE_RETREAT_APPLICATION_CLOSED=

# ---------- Local only (never on Vercel) ----------
# Outside production, only these recipients may be emailed: comma-separated
# addresses or @domain suffixes. Ignored in production (Vercel always is).
EMAIL_ALLOWED_RECIPIENTS=@test.local
MAILPIT_URL=http://127.0.0.1:54324
# Security keys as the second sign-in step: on | unset (off). Only where the
# Supabase project allows WebAuthn MFA — the local stack does; hosted Supabase
# refuses it, so leave it UNSET on Vercel. Authenticator apps are always offered
# (note 05 §11.1).
SECURITY_KEYS=on
# The hosted TEST project's database password, for the maintenance scripts
# (samples:test, stripe:archive --env …). Never read by the site.
SUPABASE_DB_PASSWORD=

# ---------- Supabase Auth email, local stack (note 09 §41.1) ----------
# Used only if [auth.email.smtp] is uncommented in supabase/config.toml — and
# then EVERY local sign-up is mailed for real, with no allowlist. Hosted
# projects set SMTP in the Supabase dashboard instead.
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# ---------- Scripts only, in .env.remote.local / .env.production.local ----------
# Testers' password for `pnpm samples:test` (8+ characters, not password123).
SAMPLE_ACCOUNT_PASSWORD=
# Direct Postgres connection string, for `pnpm content:setup` at launch. Keep it
# in .env.production.local, never in the site's runtime environment.
SUPABASE_DB_URL=
