# Tony Klinger platform — required environment variables.
# Copy to .env.local and fill in. Never commit real values.
# Architecture: note 02 §30, note 09 §49.

# ---------- Public (exposed to the browser) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Server only (never exposed to the browser) ----------
# Bypasses RLS. Server-side use only, and only where genuinely required (note 08 §61).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string. Only read by `pnpm content:setup`, the
# one-off production content load — keep it in .env.production.local, not in
# the app's runtime environment.
SUPABASE_DB_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Customer Portal settings, created by scripts/stripe-portal-setup.mjs (one per mode).
STRIPE_PORTAL_CONFIGURATION_ID=
BREVO_API_KEY=

# ---------- Email transport (note 09 §41.1) ----------
# mailpit | brevo | off.  Unset defaults to mailpit in development and OFF in
# production, so an unconfigured environment can never email a real person.
#
# The Brevo account also holds assets belonging to Tony Klinger Online Coaching,
# a legacy site being merged into this platform. They describe a DIFFERENT
# product and must not be altered or reused (note 09 §42.2); this platform owns
# its own, all prefixed "TK.com — " (note 09 §42.3). Only the transactional send
# endpoint is ever called — no contact, list or template write API is reachable
# from the code — so the legacy assets cannot be altered from here.
EMAIL_TRANSPORT=mailpit
# Outside production, only these recipients are permitted. Comma-separated
# addresses or @domain suffixes. A non-matching recipient is refused, not
# silently dropped.
EMAIL_ALLOWED_RECIPIENTS=@test.local
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Brevo template ids. TEMPLATE FIRST, HTML FALLBACK: set one and that message
# type is sent using the dashboard template with params; leave it unset and the
# built-in HTML is used. Per template, so they can be migrated one at a time.
#
# No effect locally — Mailpit cannot render a Brevo template and always shows
# the HTML.
#
# The param NAMES below must match the variables inside each Brevo template. A
# mismatch renders empty with no error from Brevo, so verify with a test send.
#   welcome               -> name, academy_url
#   order_receipt         -> total, orders_url
#   membership_activated  -> tier_name, renews_at, academy_url, benefits_url
#   guest_claim        -> claim_url, expires_at
#   booking_confirmed  -> title, starts_at, bookings_url
#   booking_cancelled  -> credit_returned, bookings_url
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_ORDER_RECEIPT=
BREVO_TEMPLATE_MEMBERSHIP_ACTIVATED=
BREVO_TEMPLATE_GUEST_CLAIM=
BREVO_TEMPLATE_BOOKING_CONFIRMED=
BREVO_TEMPLATE_BOOKING_CANCELLED=
BREVO_TEMPLATE_PRIVATE_COACHING_REBOOK=
BREVO_TEMPLATE_SECURITY_KEY_REMOVED=
MAILPIT_URL=http://127.0.0.1:54324

# ---------- Google OAuth (note 05 §7.1) ----------
# Read by supabase/config.toml via env() substitution.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------- Brevo SMTP for auth email, production only (note 09 §41.1) ----------
# Local development uses Mailpit and needs neither of these.
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
# Shared secret required by every /api/cron/[job] request (note 09 §44).
CRON_SECRET=

# --- Cloudflare Turnstile (contact form) ---------------------------------
# The site key is public and identifies the widget; only the secret key can
# verify a token. Without the secret, verification FAILS CLOSED in production
# and passes in development so the form stays testable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where contact enquiries are announced. The form never emails the address a
# visitor types — that would make it an open relay.
CONTACT_NOTIFICATION_EMAIL=

# Brevo template for the enquiry notification (optional; HTML fallback used
# when absent).
BREVO_TEMPLATE_CONTACT_ENQUIRY=

# --- Brevo contact lists -------------------------------------------------
# Sending audiences only; the consent RECORD lives in public.marketing_consents,
# which is the evidence if anyone has to prove what a person agreed to.
# Contact syncing is gated on EMAIL_TRANSPORT=brevo, exactly as sending is, so a
# stray dev run cannot add a test address to a production list.
BREVO_LIST_NEWSLETTER=
BREVO_LIST_CUSTOMERS=
BREVO_LIST_MEMBERS=
